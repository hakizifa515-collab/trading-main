// TRUST backend — authoritative data model.
//
// This schema is the source of truth for money. The frontend never computes
// or asserts a balance; every balance is derived by summing LedgerEntry rows
// for the relevant LedgerAccount. See src/ledger/ledger.service.ts.
//
// Monetary amounts use Decimal (-> PostgreSQL NUMERIC), never floating point.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity, sessions, roles
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  RESTRICTED
  PENDING_VERIFICATION
  CLOSED
}

enum KycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  passwordHash     String
  fullName         String
  country          String?
  role             Role          @default(USER)
  status           AccountStatus @default(ACTIVE)
  kycStatus        KycStatus     @default(NOT_STARTED)
  twoFactorEnabled Boolean       @default(false)
  // Real, backend-generated, unique invitation/referral code — displayed on
  // the Mine/Profile page. Assigned once at registration (see
  // auth.service.ts's generateReferralCode()); this platform has no
  // referral-reward/commission system, this is display+copy only.
  referralCode     String        @unique
  // Trade Management "USER CONTROL" (Part 28) — designates this account as
  // a sandbox fixture, never a real customer. Defaults false for every
  // existing and newly self-registered account. The ONLY code path that
  // ever sets this true is OptionsService.createTestUser (a dedicated,
  // admin-only, step-up-gated, development/test-only endpoint that creates
  // a brand-new account) — there is deliberately no route that can flip
  // this flag on an account that already exists, so no real customer's
  // account can ever retroactively become a "test user".
  isTestUser       Boolean       @default(false)
  // Only ever read/written when isTestUser is true — see settleTrade() and
  // OptionsService.setTestUserOutcomeMode. Always NORMAL for every real
  // account, since isTestUser can never be true for one.
  testOutcomeMode  TestUserOutcomeMode @default(NORMAL)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  sessions            Session[]
  accounts            Account[]
  twoFactorCredential TwoFactorCredential?
  passwordResetTokens PasswordResetToken[]
  orders              Order[]
  positions           Position[]
  deposits            Deposit[]
  withdrawals         Withdrawal[]
  kycVerifications    KycVerification[]
  userPermissions     UserPermission[]
  idempotencyKeys     IdempotencyKey[]

  adminActionsPerformed AdminAction[] @relation("AdminActionActor")
  adminActionsReceived  AdminAction[] @relation("AdminActionTarget")
  auditLogsAsActor      AuditLog[]    @relation("AuditLogActor")

  // ---- CMS (Phase 3) — which admin created/uploaded/changed content -------
  createdCmsPages         CmsPage[]         @relation("CmsPageCreatedBy")
  createdCmsAnnouncements CmsAnnouncement[] @relation("CmsAnnouncementCreatedBy")
  createdCmsFaqs          CmsFaq[]          @relation("CmsFaqCreatedBy")
  uploadedCmsMedia        CmsMedia[]        @relation("CmsMediaUploadedBy")
  cmsRevisionsMade        CmsRevision[]     @relation("CmsRevisionChangedBy")

  // ---- Support (Phase 3) ---------------------------------------------------
  supportTicketsAsCustomer  SupportTicket[]     @relation("SupportTicketCustomer")
  supportTicketsAsAgent     SupportTicket[]     @relation("SupportTicketAgent")
  supportMessagesAuthored   SupportMessage[]    @relation("SupportMessageAuthor")
  supportAssignmentsAsAgent SupportAssignment[] @relation("SupportAssignmentAgent")
  supportAssignmentsMade    SupportAssignment[] @relation("SupportAssignmentAssignedBy")

  // ---- Support notifications & attachments (Phase 4) -----------------------
  supportNotifications       SupportNotification[]
  supportAttachmentsUploaded SupportAttachment[]   @relation("SupportAttachmentUploader")

  // ---- Fixed-Time Options Trading (separate product from spot Orders) -----
  optionTrades OptionTrade[]

  @@index([role])
  @@index([status])
}

// Session tokens are opaque random values; only a hash is stored (same
// principle as a password) so a database read alone can't authenticate.
model Session {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// RFC 6238 TOTP secret. `enabled` only flips true after the user verifies a
// live code during setup (see auth/totp.util.ts) — never on creation alone.
model TwoFactorCredential {
  id        String   @id @default(uuid())
  userId    String   @unique
  secret    String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Forgot/Reset Password (Part 5) — same principle as Session: the raw,
// high-entropy random token is only ever sent to the user via email; the
// database stores nothing but its SHA-256 hash (tokenHash, hashed with the
// same hashToken() Session already uses), so a database read alone can
// never be used to take over an account. Single-use (usedAt) and
// short-lived (expiresAt — see auth.service.ts's RESET_TOKEN_TTL_MS).
// usedAt is also set when a token is superseded by a newer request for the
// same account (Part 3: "invalidate previous unused reset tokens"), not
// only when a reset actually completes — both cases mean "this token can
// never be redeemed again," which is the only thing resetPassword() checks.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Foundation for fine-grained permissions beyond the coarse Role enum.
// Not deeply wired into every guard yet — see backend/README.md.
model Permission {
  id          String @id @default(uuid())
  key         String @unique
  description String

  userPermissions UserPermission[]
}

model UserPermission {
  id           String   @id @default(uuid())
  userId       String
  permissionId String
  grantedAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

// ---------------------------------------------------------------------------
// Accounts & double-entry ledger
// ---------------------------------------------------------------------------

enum AccountType {
  TRADING
}

// A customer-facing account container. One user can have more than one
// Account in the future (e.g. distinct trading accounts); today each user
// gets exactly one TRADING account, created at registration.
model Account {
  id        String        @id @default(uuid())
  userId    String
  type      AccountType   @default(TRADING)
  status    AccountStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerAccounts LedgerAccount[]
  orders         Order[]
  positions      Position[]
  optionTrades   OptionTrade[]

  @@index([userId])
}

enum LedgerOwnerType {
  USER
  SYSTEM
}

enum LedgerAccountType {
  CASH // user's available cash
  RESERVED // user's margin/investment reserved against open positions
  REVENUE // system: realized customer losses / spread / fees land here
  FEES // system: fees collected
  SUSPENSE // system: counterparty for deposits/withdrawals until reconciled
  // against a real external payment/broker event
}

// A bookkeeping account. Its balance is NEVER stored directly — it is always
// derived as SUM(credits) - SUM(debits) over its LedgerEntry rows.
model LedgerAccount {
  id        String            @id @default(uuid())
  accountId String? // null for SYSTEM ledger accounts
  ownerType LedgerOwnerType
  type      LedgerAccountType
  currency  String            @default("USD")
  createdAt DateTime          @default(now())

  account Account?      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  entries LedgerEntry[]

  // Phase 6F: widened from @@unique([accountId, type]) to include currency —
  // exactly one CASH and one RESERVED ledger account per (user Account,
  // currency) pair, so a customer can hold e.g. CASH/USD, CASH/USDT, and
  // CASH/BTC simultaneously (spot asset holdings, Phase 6E §6/§23) instead
  // of being limited to a single currency per type. Exactly one of each
  // SYSTEM type per currency overall.
  @@unique([accountId, type, currency])
  @@index([ownerType, type])
}

enum LedgerEntryType {
  DEPOSIT
  WITHDRAWAL
  TRADE_RESERVATION
  TRADE_RELEASE
  // Phase 6F Checkpoint C — the actual transfer of value driven by a
  // provider-confirmed fill. Distinct from TRADE_RESERVATION (funds set
  // aside) and TRADE_RELEASE (an UNUSED reservation returned to CASH) —
  // reusing either for "the trade actually happened" would be semantically
  // wrong. See ledger.service.ts / orders.service.ts for the exact entry
  // pairs this produces.
  TRADE_SETTLEMENT
  REALIZED_PROFIT
  REALIZED_LOSS
  FEE
  REFUND
  ADJUSTMENT
  // Part 32 — customer-initiated currency conversion (e.g. USDT -> BTC),
  // priced from the same real MarketDataService quotes every other product
  // in this codebase uses. Always posted as a DEBIT on the source currency
  // paired with a CREDIT on the destination currency, both within the
  // user's own account — never a system/revenue account, since no value is
  // created or destroyed, only exchanged. See AccountsService.convert().
  CONVERSION
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

// A balanced group of entries. Every financial event (deposit confirmation,
// withdrawal, trade open/close, admin adjustment) posts exactly one
// LedgerTransaction whose entries sum to zero per currency
// (SUM(credits) == SUM(debits)) — enforced in LedgerService, not just by
// convention. `idempotencyKey` lets a retried request (webhook redelivery,
// duplicate click) resolve to the same transaction instead of double-posting.
model LedgerTransaction {
  id             String   @id @default(uuid())
  idempotencyKey String?  @unique
  description    String
  relatedType    String? // e.g. "DEPOSIT" | "WITHDRAWAL" | "ORDER" | "ADMIN_ACTION"
  relatedId      String?
  createdAt      DateTime @default(now())

  entries      LedgerEntry[]
  deposits     Deposit[]
  withdrawals  Withdrawal[]
  adminActions AdminAction[]

  @@index([relatedType, relatedId])
}

model LedgerEntry {
  id              String          @id @default(uuid())
  transactionId   String
  ledgerAccountId String
  direction       LedgerDirection
  amount          Decimal         @db.Decimal(20, 8) // always positive; direction carries the sign
  currency        String          @default("USD")
  entryType       LedgerEntryType
  createdAt       DateTime        @default(now())

  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id])
  ledgerAccount LedgerAccount     @relation(fields: [ledgerAccountId], references: [id])

  @@index([ledgerAccountId])
  @@index([transactionId])
}

// ---------------------------------------------------------------------------
// Orders, fills, positions — foundation only, no broker connected
// ---------------------------------------------------------------------------

enum OrderSide {
  BUY
  SELL
}

enum OrderStatus {
  PENDING
  SUBMITTED
  // Phase 6F Checkpoint D — LIMIT order lifecycle states. OPEN: accepted by
  // the provider and resting, not yet (fully) filled. CANCEL_PENDING: a
  // cancel request was sent to the provider, outcome not yet confirmed —
  // never assume cancellation succeeded merely because the request was
  // sent (see orders.service.ts's cancelOrder()). EXPIRED: the provider
  // reported the order expired — no expiration ENGINE is implemented this
  // checkpoint (no scheduler, no time-based auto-cancel); this value exists
  // only so a provider-reported expiry is never misrepresented as
  // something else if one is ever received.
  OPEN
  CANCEL_PENDING
  EXPIRED
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  REJECTED
}

// This phase does not connect a real broker/exchange. Orders created via the
// foundation API stay PENDING/REJECTED — nothing transitions them to FILLED
// except an actual fill record, and nothing in this phase creates one.
model Order {
  id              String      @id @default(uuid())
  userId          String
  accountId       String
  symbol          String
  side            OrderSide
  quantity        Decimal     @db.Decimal(20, 8)
  orderType       String      @default("MARKET")
  requestedPrice  Decimal?    @db.Decimal(20, 8)
  executedPrice   Decimal?    @db.Decimal(20, 8)
  filledQuantity  Decimal     @default(0) @db.Decimal(20, 8)
  fee             Decimal     @default(0) @db.Decimal(20, 8)
  // Phase 6F Checkpoint C — Order.fee without a currency is ambiguous once
  // a fee can be charged in the base asset, quote asset, or a third asset
  // (e.g. BNB) — see execution-provider.types.ts's ProviderFill.feeAsset,
  // which this is populated from. Null until a real fill exists.
  feeAsset        String?
  status          OrderStatus @default(PENDING)
  externalOrderId String? // broker/exchange order ID once one exists
  // The TRUST-generated, provider-facing execution idempotency key (see
  // execution/client-order-id.ts) — persisted so a provider timeout/lost
  // response can be resolved by re-querying the SAME id later, rather than
  // TRUST ever needing to guess or generate a new one for the same attempt.
  clientOrderId   String?
  rejectionReason String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  account  Account   @relation(fields: [accountId], references: [id])
  fills    Fill[]
  position Position?

  @@index([userId])
  @@index([status])
}

model Fill {
  id             String   @id @default(uuid())
  orderId        String
  price          Decimal  @db.Decimal(20, 8)
  quantity       Decimal  @db.Decimal(20, 8)
  fee            Decimal  @default(0) @db.Decimal(20, 8)
  // Phase 6F Checkpoint C — see Order.feeAsset above; a fee amount with no
  // currency is not a meaningful record of what actually happened.
  feeAsset       String?
  executedAt     DateTime @default(now())
  externalFillId String?

  order Order @relation(fields: [orderId], references: [id])

  // Phase 6F Checkpoint D, Part 11/13 — real, DB-enforced deduplication: a
  // provider fill ID must never be applied twice to the same order.
  // Postgres treats each NULL as distinct, so this does not block legacy
  // rows with no externalFillId; it only ever rejects a genuine repeat.
  @@unique([orderId, externalFillId])
  @@index([orderId])
}

enum PositionStatus {
  OPEN
  CLOSED
}

model Position {
  id            String         @id @default(uuid())
  userId        String
  accountId     String
  orderId       String?        @unique // opening order, if any
  symbol        String
  side          OrderSide
  quantity      Decimal        @db.Decimal(20, 8)
  avgEntryPrice Decimal        @db.Decimal(20, 8)
  currentPrice  Decimal?       @db.Decimal(20, 8)
  realizedPnl   Decimal        @default(0) @db.Decimal(20, 8)
  fees          Decimal        @default(0) @db.Decimal(20, 8)
  status        PositionStatus @default(OPEN)
  openedAt      DateTime       @default(now())
  closedAt      DateTime?

  user    User    @relation(fields: [userId], references: [id])
  account Account @relation(fields: [accountId], references: [id])
  order   Order?  @relation(fields: [orderId], references: [id])

  @@index([userId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Deposits & withdrawals — foundation only, no payment provider connected
// ---------------------------------------------------------------------------

enum DepositStatus {
  PENDING
  PROCESSING
  CONFIRMED
  FAILED
  REVERSED
}

// A frontend "success" screen must NEVER move this to CONFIRMED. Only
// DepositsService.confirm() (an admin action in this phase; a verified
// payment-provider webhook in a future phase) may do that, and it does so
// inside the same DB transaction as the LedgerTransaction that credits cash.
model Deposit {
  id                  String        @id @default(uuid())
  userId              String
  amount              Decimal       @db.Decimal(20, 8)
  currency            String        @default("USD")
  method              String
  providerReference   String?
  status              DepositStatus @default(PENDING)
  ledgerTransactionId String?       @unique
  createdAt           DateTime      @default(now())
  confirmedAt         DateTime?

  // ---- Checkpoint K: crypto deposit fields — all nullable, populated only
  // when method = "CRYPTO" (see deposits.service.ts). SNAPSHOTTED at
  // creation from CryptoAsset/CryptoDepositAddress — deliberately NOT a
  // foreign key to CryptoDepositAddress, so a later admin address change
  // can never alter what an already-created deposit displays (Part 15).
  // MediaStorageService is reused exactly as CmsMedia/SupportAttachment
  // already do (Part 20) — no second storage mechanism.
  cryptoAssetSymbol String? // e.g. "USDT" — snapshot, not a live FK
  networkCode       String? // e.g. "TRC20" — snapshot, not a live FK
  receivingAddress  String? // the exact address shown to the user for THIS deposit, immutable after creation
  proofFilename     String?
  proofMimeType     String?
  proofSize         Int?
  proofStorageKey   String?

  user              User               @relation(fields: [userId], references: [id])
  ledgerTransaction LedgerTransaction? @relation(fields: [ledgerTransactionId], references: [id])

  @@index([userId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Checkpoint K — Crypto Deposit configuration. Two models (not three): a
// CryptoAsset (USDT, BTC, ...) and a CryptoDepositAddress representing one
// (asset, network) combination's current receiving address. Network and
// address are 1:1 per the product rule (Part 11: exactly one ACTIVE address
// per asset+network), so they are NOT split into a separate CryptoNetwork
// table with its own address table — that would be the same cardinality
// with an extra join for no benefit. `@@unique([cryptoAssetId, networkCode])`
// is what makes "crypto + network uniquely identifies its configuration" a
// real database constraint, not just an application-level convention.
//
// Deliberately NOT adding blockchain-verification columns (txHash,
// confirmations, detectedAmount, ...) here or on Deposit — Part 45 asks for
// a design that doesn't PRECLUDE that later (any nullable column is
// additive), not for those columns to exist and sit unused now; Deposit's
// pre-existing `providerReference` field can already hold a transaction
// reference if ever needed before a dedicated migration adds more.
// ---------------------------------------------------------------------------

// New assets default DISABLED — same "a brand-new financial capability must
// never silently go live" posture as OptionsSettings.tradingEnabled and
// OptionMarket.enabled (Checkpoint J).
model CryptoAsset {
  id        String   @id @default(uuid())
  symbol    String   @unique // "USDT", "BTC", "ETH", ...
  name      String // "Tether", "Bitcoin", ...
  enabled   Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  networks CryptoDepositAddress[]

  @@index([enabled])
}

model CryptoDepositAddress {
  id               String   @id @default(uuid())
  cryptoAssetId    String
  networkCode      String // "TRC20", "ERC20", "BEP20", "BTC", "SOL", ...
  networkName      String // "Tron (TRC20)", "Bitcoin", ...
  enabled          Boolean  @default(false)
  receivingAddress String
  minimumDeposit   Decimal? @db.Decimal(20, 8) // null = no configured minimum
  sortOrder        Int      @default(0)
  // Optional admin-uploaded QR image of the receiving address, via the
  // existing MediaStorageService abstraction (Admin Panel redesign) — never
  // a second, unsafe upload path. Null = no QR uploaded; the customer-facing
  // deposit page already renders a client-generated QR from the address
  // text regardless (see src/components/QrCode.tsx), so this is optional.
  qrStorageKey     String?
  updatedByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cryptoAsset CryptoAsset @relation(fields: [cryptoAssetId], references: [id], onDelete: Cascade)

  @@unique([cryptoAssetId, networkCode])
  @@index([enabled])
}

// Admin-managed external support/contact links shown to customers (e.g. LINE,
// Telegram) — Admin Panel redesign. Same "new capability defaults off"
// posture as CryptoAsset/OptionMarket above. iconStorageKey is optional and
// goes through the same MediaStorageService abstraction as every other
// upload in this codebase — never a raw filesystem path.
model AdminContact {
  id               String   @id @default(uuid())
  name             String
  url              String
  iconStorageKey   String?
  enabled          Boolean  @default(false)
  sortOrder        Int      @default(0)
  updatedByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([enabled])
}

enum WithdrawalStatus {
  PENDING
  REVIEW
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  FAILED
  REVERSED
}

model Withdrawal {
  id                  String           @id @default(uuid())
  userId              String
  amount              Decimal          @db.Decimal(20, 8)
  currency            String           @default("USD")
  destination         String
  status              WithdrawalStatus @default(PENDING)
  riskFlags           String[]         @default([])
  approvedByAdminId   String?
  ledgerTransactionId String?          @unique
  createdAt           DateTime         @default(now())
  completedAt         DateTime?

  user              User               @relation(fields: [userId], references: [id])
  ledgerTransaction LedgerTransaction? @relation(fields: [ledgerTransactionId], references: [id])

  @@index([userId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// KYC — status tracking only, no verification provider connected
// ---------------------------------------------------------------------------

enum KycIdType {
  NATIONAL_ID
  PASSPORT
  DRIVERS_LICENSE
}

enum KycDocumentKind {
  FRONT
  BACK
  SELFIE
}

model KycVerification {
  id                String     @id @default(uuid())
  userId            String
  status            KycStatus  @default(PENDING)
  providerReference String?
  // ---- Submission details (Checkpoint: Mine/Profile + KYC) -----------------
  // Nullable because pre-existing rows (created before this checkpoint, via
  // the old providerReference-only submit()) never collected these — never
  // backfilled with fake identity data.
  fullName          String?
  dateOfBirth       DateTime?
  country           String?
  idType            KycIdType?
  idNumber          String?
  submittedAt       DateTime   @default(now())
  reviewedAt        DateTime?
  reviewedByAdminId String?
  rejectionReason   String?

  user      User          @relation(fields: [userId], references: [id])
  documents KycDocument[]

  @@index([userId])
  @@index([status])
}

// Uploaded ID/selfie images — a separate table (not columns bolted onto
// KycVerification) since a submission holds a variable set of 1-3 documents
// (PASSPORT: front only; NATIONAL_ID/DRIVERS_LICENSE: front+back; every type
// additionally requires a selfie). Stored via the existing shared
// MediaStorageService (backend/src/cms/media-storage.service.ts) — private
// disk storage, random storageKey, never a public URL. Access is gated by
// ownership-or-kyc.read-permission, mirroring Deposit proof access exactly
// (see kyc.service.ts's getDocumentFile()).
model KycDocument {
  id             String          @id @default(uuid())
  verificationId String
  kind           KycDocumentKind
  storageKey     String
  mimeType       String
  filename       String
  size           Int
  createdAt      DateTime        @default(now())

  verification KycVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@unique([verificationId, kind])
  @@index([verificationId])
}

// ---------------------------------------------------------------------------
// Client-supplied idempotency (Phase 2.1) — a reusable mechanism, not three
// bespoke ones. Any endpoint that creates a financial record (deposits,
// withdrawals, orders) may be called with an Idempotency-Key header; see
// src/common/idempotency/idempotency.service.ts for how this table is used.
// Scoped per (userId, scope, key) — different users never share state, and
// different endpoints ("scope") never collide even if a client reused the
// same key value across them.
// ---------------------------------------------------------------------------

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
}

model IdempotencyKey {
  id           String            @id @default(uuid())
  userId       String
  scope        String // e.g. "deposits.create", "withdrawals.create", "orders.create"
  key          String // the client-supplied Idempotency-Key header value
  requestHash  String // hash of the request's financially-meaningful fields — a retry with
  // the same key but different fields is rejected, never silently reused
  status       IdempotencyStatus @default(PROCESSING)
  responseBody Json? // the exact response returned the first time, replayed verbatim on retry
  createdAt    DateTime          @default(now())
  completedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, key])
  @@index([userId, scope])
}

// ---------------------------------------------------------------------------
// Admin actions & audit log
// ---------------------------------------------------------------------------

// A record of a specific privileged action an admin took, always linked to
// its audit log entry and (when financial) its LedgerTransaction. This is
// distinct from AuditLog: AdminAction is the "what admins did" table used by
// the admin UI; AuditLog is the append-only security/compliance trail that
// also records non-admin security events (logins, failed logins, etc).
model AdminAction {
  id                  String   @id @default(uuid())
  adminId             String
  action              String // e.g. "FINANCIAL_ADJUSTMENT" | "USER_SUSPENDED" | ...
  targetUserId        String?
  reason              String?
  previousState       Json?
  newState            Json?
  ledgerTransactionId String?
  createdAt           DateTime @default(now())

  admin             User               @relation("AdminActionActor", fields: [adminId], references: [id])
  targetUser        User?              @relation("AdminActionTarget", fields: [targetUserId], references: [id])
  ledgerTransaction LedgerTransaction? @relation(fields: [ledgerTransactionId], references: [id])

  @@index([adminId])
  @@index([targetUserId])
  @@index([action])
}

// Append-only from the application's perspective: no service method in this
// codebase updates or deletes an AuditLog row. actorId is null for
// system-generated events (e.g. automated settlement, if implemented later).
model AuditLog {
  id            String   @id @default(uuid())
  actorId       String?
  action        String
  targetType    String?
  targetId      String?
  ipAddress     String?
  userAgent     String?
  previousState Json?
  newState      Json?
  reason        String?
  metadata      Json?
  createdAt     DateTime @default(now())

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Platform-wide and per-market controls (server-enforced kill switches)
// ---------------------------------------------------------------------------

// Singleton row (id is always "singleton"). Read by guards on the
// orders/deposits/withdrawals/auth-registration endpoints before allowing
// the operation — flipping these actually blocks the corresponding API,
// it is not a UI-only switch.
model PlatformSettings {
  id                   String   @id @default("singleton")
  tradingEnabled       Boolean  @default(true)
  depositsEnabled      Boolean  @default(true)
  withdrawalsEnabled   Boolean  @default(true)
  registrationsEnabled Boolean  @default(true)
  updatedAt            DateTime @updatedAt
  updatedByAdminId     String?
  // Phase 6F Checkpoint F, Part 6/9 — global ceiling on how many
  // simultaneously-open orders (PENDING/SUBMITTED/OPEN/PARTIALLY_FILLED/
  // CANCEL_PENDING — see order-risk-math.ts's OPEN_ORDER_STATUSES) one
  // user account may hold at once. Nullable = not enforced (Checkpoint E
  // Part 16: no authoritative value exists yet; do not invent one).
  maxOpenOrdersPerUser Int?
  // Support ticket auto-greeting — a real, persisted SupportMessage created
  // by SupportService.createTicket() the moment a customer opens a new
  // ticket, authored by a real staff account (supportAutoGreetingSenderId),
  // never a fabricated/bot sender. All three fields are optional and the
  // feature defaults off; the sender must be a real ADMIN/SUPER_ADMIN,
  // validated in AdminService.updatePlatformSettings() at write time (not
  // enforced at the DB level, matching updatedByAdminId's existing
  // plain-String-no-FK convention above).
  supportAutoGreetingEnabled   Boolean @default(false)
  supportAutoGreetingMessage   String?
  supportAutoGreetingSenderId  String?
  // Admin support-notification email (ADMIN NOTIFICATIONS feature) — where
  // SupportService emails "New Support Ticket" / "Customer Reply" alerts.
  // Free-text address, not an FK to User — same convention as
  // supportAutoGreetingSenderId's siblings above; this may be a shared ops
  // inbox rather than any one admin's login email. Nullable = feature is a
  // silent no-op until an address is configured (never a hardcoded
  // fallback address — see EmailService.sendSupportNotificationEmail()).
  supportNotificationEmail String?
}

enum MarketDataSource {
  LIVE // real external feed (e.g. GoldAPI for XAU/USD)
  SIMULATED // internally generated price, must never be presented as LIVE
}

// Phase 6B, Part 3 — the platform must not blindly assume every instrument
// is a crypto spot asset. Only CRYPTO_SPOT is actually used today (see
// seed.ts); CFD/FOREX/OTHER exist in the enum so a genuinely different
// instrument shape doesn't force a schema change later, but no row uses
// them yet — do not read their presence here as "forex is supported."
enum MarketType {
  CRYPTO_SPOT
  CFD
  FOREX
  OTHER
}

// Instrument configuration — the database is authoritative for the
// supported symbol list, display metadata, precision, and market type
// (Phase 6B, Part 4). Extended in place rather than replaced with a new
// table: every existing column/consumer (OrdersService, AdminService,
// MarketsController) keeps working unchanged; only new, additive,
// defaulted columns were added.
model MarketConfig {
  id              String           @id @default(uuid())
  symbol          String           @unique // TRUST's own symbol, e.g. "BTC/USDT" — see Part 11; providerSymbol below is the separate provider-specific identifier
  dataSource      MarketDataSource
  tradingEnabled  Boolean          @default(true)
  maintenanceMode Boolean          @default(false)
  updatedAt       DateTime         @updatedAt

  // ---- Added Phase 6B ---------------------------------------------------
  baseAsset           String     @default("")
  quoteAsset          String     @default("")
  displayName         String     @default("")
  marketType          MarketType @default(CRYPTO_SPOT)
  enabled             Boolean    @default(true) // whether this instrument is offered/listed at all — distinct from tradingEnabled (Part 13: data can be LIVE while trading is DISABLED, or vice versa)
  pricePrecision      Int        @default(2)
  quantityPrecision   Int        @default(8)
  minimumQuantity     Decimal?   @db.Decimal(20, 8)
  maximumQuantity     Decimal?   @db.Decimal(20, 8)
  // Phase 6F Checkpoint F — pre-trade risk limits (Part 6). Nullable, same
  // "absent = not enforced" convention as minimumQuantity/maximumQuantity
  // above (Checkpoint E Part 16 explicitly rejected inventing a numeric
  // default for any of these; RiskEngineService treats null as "this check
  // does not apply to this market," never as a configuration error).
  // maxOrderNotional: the ceiling on a single order's notional value, in
  // the market's quote asset. maxPositionQuantity: the ceiling on total
  // held BASE-asset quantity (existing holdings + this order, for BUY
  // only — a SELL can only ever reduce holdings) an account may reach.
  maxOrderNotional    Decimal?   @db.Decimal(20, 8)
  maxPositionQuantity Decimal?   @db.Decimal(20, 8)
  // Which MarketDataProvider adapter sources this instrument's quotes
  // ("GOLDAPI", "SIMULATED"), and that provider's own identifier for it
  // (Part 11 — explicit symbol mapping, never assumed identical to TRUST's
  // own `symbol`). Null provider = no data source configured; the Market
  // Data Service returns UNAVAILABLE for such a symbol, never a fabricated
  // quote.
  provider            String?
  providerSymbol      String?
  createdAt           DateTime   @default(now())

  @@index([symbol])
  @@index([enabled])
}

// ---------------------------------------------------------------------------
// CMS (Phase 3) - customer-facing content, database-driven, never
// hand-editable-HTML from an admin (see CmsPage.sections: structured JSON
// content blocks, not raw HTML - the frontend renderer maps known block
// types to components; there is no arbitrary HTML field anywhere here).
// Deliberately NOT one megatable with a kind discriminator (as an earlier,
// vaguer-requirements audit had proposed) - Pages/Announcements/FAQs each
// have genuinely different fields now that the requirements are concrete
// (scheduling+priority+audience for announcements, category+ordering for
// FAQs, SEO+sections for pages), so purpose-built tables are the smaller,
// cleaner design here, not the reverse.
// ---------------------------------------------------------------------------

enum CmsContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CmsPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// One row per site page (Homepage, About, FAQ, Terms, etc.), addressed by
// slug. sections is an ordered JSON array of { type, fields } content
// blocks - e.g. { type: "hero", fields: { title, subtitle, ctaLabel,
// ctaHref } }. Validated server-side against known block types
// (cms.service.ts) before save; never raw HTML.
model CmsPage {
  id               String           @id @default(uuid())
  slug             String           @unique
  title            String
  sections         Json
  seoTitle         String?
  seoDescription   String?
  status           CmsContentStatus @default(DRAFT)
  publishedAt      DateTime?
  createdByAdminId String
  updatedByAdminId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  createdBy User @relation("CmsPageCreatedBy", fields: [createdByAdminId], references: [id])

  @@index([status])
}

model CmsAnnouncement {
  id               String           @id @default(uuid())
  title            String
  body             String
  priority         CmsPriority      @default(NORMAL)
  status           CmsContentStatus @default(DRAFT)
  loggedInOnly     Boolean          @default(false)
  startAt          DateTime?
  endAt            DateTime?
  publishedAt      DateTime?
  createdByAdminId String
  updatedByAdminId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  createdBy User @relation("CmsAnnouncementCreatedBy", fields: [createdByAdminId], references: [id])

  @@index([status])
  @@index([startAt, endAt])
}

model CmsFaq {
  id               String           @id @default(uuid())
  question         String
  answer           String
  category         String           @default("General")
  order            Int              @default(0)
  status           CmsContentStatus @default(DRAFT)
  createdByAdminId String
  updatedByAdminId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  createdBy User @relation("CmsFaqCreatedBy", fields: [createdByAdminId], references: [id])

  @@index([status])
  @@index([category])
}

enum CmsMediaKind {
  IMAGE
  DOCUMENT
  LOGO
  BANNER
}

// Metadata only - the actual file bytes live outside PostgreSQL (local disk
// in development, behind a small storage-abstraction interface designed so
// a production deployment can swap in real object storage later without a
// schema change; see media-storage.service.ts). storageKey is opaque to
// everything except that storage layer.
model CmsMedia {
  id                String       @id @default(uuid())
  filename          String
  mimeType          String
  size              Int
  storageKey        String
  kind              CmsMediaKind
  uploadedByAdminId String
  createdAt         DateTime     @default(now())

  uploadedBy User @relation("CmsMediaUploadedBy", fields: [uploadedByAdminId], references: [id])

  @@index([kind])
}

// Validated destinations only (internal paths, or an explicit external
// allowlist) - see cms.service.ts. Prevents CMS-managed navigation from
// becoming a way to inject an arbitrary/unsafe route.
model CmsNavigationItem {
  id          String   @id @default(uuid())
  label       String
  destination String
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

// Generic revision store shared by every CMS content type - one table, not
// one per type. Holds the FULL content snapshot as it was immediately
// BEFORE the change being recorded, so restore is just apply this
// snapshot. Distinct from the immutable financial AuditLog: this is
// business content history, not a compliance/security trail (AuditLog
// still separately records CONTENT_* events for who/what/when).
model CmsRevision {
  id               String   @id @default(uuid())
  entityType       String
  entityId         String
  snapshot         Json
  changedByAdminId String
  reason           String?
  createdAt        DateTime @default(now())

  changedBy User @relation("CmsRevisionChangedBy", fields: [changedByAdminId], references: [id])

  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Customer Support (Phase 3) - a separate permission domain from financial
// admin (see backend/src/common/permissions.ts). A support agent is never
// implicitly a financial admin, and vice versa.
// ---------------------------------------------------------------------------

model SupportCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tickets SupportTicket[]

  @@index([isActive])
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  WAITING_INTERNAL
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// priority is the authoritative, staff-controlled field (defaults to the
// customer's requested priority but only staff with support.tickets.update
// may change it thereafter). requestedPriority is what the customer picked
// at creation time - preserved as-is, purely informational, never used to
// gate anything server-side.
model SupportTicket {
  id                String              @id @default(uuid())
  userId            String
  categoryId        String
  subject           String
  status            SupportTicketStatus @default(OPEN)
  priority          SupportPriority     @default(NORMAL)
  requestedPriority SupportPriority     @default(NORMAL)
  assignedAgentId   String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  resolvedAt        DateTime?
  closedAt          DateTime?

  user          User                  @relation("SupportTicketCustomer", fields: [userId], references: [id], onDelete: Restrict)
  category      SupportCategory       @relation(fields: [categoryId], references: [id])
  assignedAgent User?                 @relation("SupportTicketAgent", fields: [assignedAgentId], references: [id])
  messages      SupportMessage[]
  assignments   SupportAssignment[]
  notifications SupportNotification[]

  @@index([userId])
  @@index([status])
  @@index([assignedAgentId])
  @@index([categoryId])
}

enum SupportMessageVisibility {
  PUBLIC
  INTERNAL
}

model SupportMessage {
  id         String                   @id @default(uuid())
  ticketId   String
  authorId   String
  body       String
  visibility SupportMessageVisibility @default(PUBLIC)
  createdAt  DateTime                 @default(now())
  editedAt   DateTime?
  // Soft delete (Support Audit) — mirrors editedAt's own nullable-timestamp
  // shape. Deliberately NOT a hard delete: the row, its body, and its
  // attachments are all left completely intact so the Support Audit feed can
  // still show what was deleted, by whom, and when (paired with the
  // MESSAGE_DELETED AuditLog entry, which additionally preserves the
  // original body in previousState even if this row's body were ever
  // scrubbed later). Every ordinary customer/admin read path filters
  // deletedAt: null; only SupportService.listSupportAuditFeed() does not.
  deletedAt        DateTime?
  deletedByAdminId String?

  ticket      SupportTicket       @relation(fields: [ticketId], references: [id])
  author      User                @relation("SupportMessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  attachments SupportAttachment[]

  @@index([ticketId])
  @@index([visibility])
  @@index([deletedAt])
}

// A file attached to a support message (Phase 4, Part 15). Reuses the exact
// same storage abstraction as CmsMedia (MediaStorageService) - metadata in
// Postgres, bytes on local disk, allowlisted + magic-byte-verified content,
// server-generated storage keys, original filename never trusted for
// anything but display. Unlike CmsMedia (intentionally public - it only ever
// backs public site content), an attachment's bytes are only ever served
// through SupportService.getAttachmentFile(), which requires either ticket
// ownership or the support.tickets.read permission - never a public URL.
model SupportAttachment {
  id               String   @id @default(uuid())
  messageId        String
  filename         String
  mimeType         String
  size             Int
  storageKey       String
  uploadedByUserId String
  createdAt        DateTime @default(now())

  message        SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploadedByUser User           @relation("SupportAttachmentUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@index([messageId])
}

// Server-backed notification record (Phase 4, Part 16) - reuses no separate
// system; this IS the one notification mechanism for support events. Works
// for both customers and staff since both are User rows and a ticket's
// "recipient" for a given event may be either (see SupportService's private
// notify() helper for exactly which event notifies which recipient).
// `message` is always a short, non-sensitive preview (ticket subject/status
// only) - message BODIES are never copied into a notification row.
model SupportNotification {
  id        String    @id @default(uuid())
  userId    String
  ticketId  String
  event     String
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user   User          @relation(fields: [userId], references: [id])
  ticket SupportTicket @relation(fields: [ticketId], references: [id])

  @@index([userId, readAt])
  @@index([ticketId])
}

// Append-only assignment history - reassigning a ticket inserts a new row
// and stamps unassignedAt on the previous one; nothing is ever deleted.
// SupportTicket.assignedAgentId is a denormalized current-assignee pointer
// for fast queries, kept in sync whenever a new row is inserted here - this
// table is the authoritative history.
model SupportAssignment {
  id                String    @id @default(uuid())
  ticketId          String
  agentId           String
  assignedByAdminId String
  assignedAt        DateTime  @default(now())
  unassignedAt      DateTime?

  ticket     SupportTicket @relation(fields: [ticketId], references: [id])
  agent      User          @relation("SupportAssignmentAgent", fields: [agentId], references: [id])
  assignedBy User          @relation("SupportAssignmentAssignedBy", fields: [assignedByAdminId], references: [id])

  @@index([ticketId])
  @@index([agentId])
}

// ---------------------------------------------------------------------------
// Fixed-Time Options Trading — a SEPARATE product from spot Orders/Positions
// above. Deliberately its own small domain (own settings singleton, own
// trade lifecycle) rather than folded into PlatformSettings/Order/Position,
// per the product requirement that spot trading remain fully independent
// and unmodified. Reuses everything else: User/Account, LedgerService (same
// LedgerEntryType values, no new ones needed), IdempotencyKey (via the
// existing IdempotencyService, scope "options.create"), MarketConfig (an
// OptionMarket.symbol always matches an existing MarketConfig.symbol — this
// is how price sourcing is reused via MarketDataService.getQuote() without
// a second provider-mapping mechanism).
// ---------------------------------------------------------------------------

// Per-asset options-product configuration, layered on top of an existing
// MarketConfig row (referenced loosely by symbol, exactly like Order.symbol
// already does — no FK, resolved dynamically, consistent with the existing
// pattern). `enabled` is this product's own listing switch, independent of
// MarketConfig.tradingEnabled (spot) and OptionsSettings.tradingEnabled (the
// platform-wide options kill switch below) — three independent layers,
// same "defense in depth" shape RiskEngineService already uses for spot.
model OptionMarket {
  id            String   @id @default(uuid())
  symbol        String   @unique // matches MarketConfig.symbol, e.g. "XAU/USD", "BTC/USDT"
  enabled       Boolean  @default(false)
  currency      String   @default("USDT") // stake/settlement currency for this asset's option trades
  minInvestment Decimal  @default(1) @db.Decimal(20, 8)
  maxInvestment Decimal? @db.Decimal(20, 8) // null = no per-trade maximum beyond platform-wide limits
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  durations OptionDuration[]

  @@index([enabled])
}

// One row per (asset, duration) — the admin-configured payout for that
// specific combination (Part 5: durations are NOT a shared global list,
// each asset enables its own subset with its own payout).
model OptionDuration {
  id              String   @id @default(uuid())
  optionMarketId  String
  durationSeconds Int
  enabled         Boolean  @default(true)
  payoutPercent   Decimal  @db.Decimal(6, 3) // e.g. 5.000 = 5%
  // Amount-tier trading ticket (Part 29) — the minimum investment required
  // to qualify for THIS duration/payout tier (e.g. $10 -> 30s/5%, $50 ->
  // 60s/10%, $100 -> 90s/15%). The trading UI resolves duration+payout
  // automatically from whichever amount the user types — the highest
  // minAmount tier at or below the entered amount — never a manually
  // clicked/typed duration. Default 0 preserves prior behavior for any
  // duration an admin never assigns a threshold to (always qualifies).
  // Enforced server-side in OptionsRiskService, never trusted from the
  // client — see that file's DURATION_MIN_AMOUNT_NOT_MET check.
  minAmount       Decimal  @default(0) @db.Decimal(20, 8)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  optionMarket OptionMarket @relation(fields: [optionMarketId], references: [id], onDelete: Cascade)

  @@unique([optionMarketId, durationSeconds])
  @@index([optionMarketId])
}

enum OptionDirection {
  BUY // predicts expiry price will be HIGHER than entry
  SELL // predicts expiry price will be LOWER than entry
}

enum OptionResult {
  WIN
  LOSS
  DRAW
}

// Deliberately minimal (Part 16: "do not add unnecessary states"). Result
// determination and ledger settlement happen ATOMICALLY as one step (see
// options.service.ts) — there is no persisted "WON but not yet settled"
// state, since that would itself be exactly the kind of partial financial
// state Part 11/38 forbid. `result` (above) carries WIN/LOSS/DRAW once
// known; `status` carries lifecycle only.
enum OptionTradeStatus {
  ACTIVE // counting down, stake reserved, no result yet
  SETTLED // terminal — result determined AND ledger entries posted, together
  UNRESOLVED // expiry reached but an authoritative expiry price could not be
  // obtained — stake remains reserved, never a fabricated result;
  // the expiry sweep retries this exactly like ACTIVE (Part 30)
}

// Demo/test-only result forcing (Part 26). Persisted per-trade — never a
// global admin dial — so every forced outcome is individually visible and
// auditable on the trade record itself, and can never be mistaken for an
// organic market result. NORMAL is the only value the production backend
// will ever accept (enforced in options.service.ts via NODE_ENV, not by
// any database-configurable toggle — Part 26 explicitly forbids a hidden
// mechanism an operator could flip in production).
enum OptionResultMode {
  NORMAL
  FORCE_WIN
  FORCE_LOSS
  FORCE_DRAW
}

// Trade Management "USER CONTROL" (Part 28) — a per-user test-outcome
// override, distinct from both OptionTrade.requestedResultMode (per-trade,
// chosen by whoever creates the trade) and OptionsSettings.sandboxOutcomeMode
// (platform-wide). Only ever consulted for a user whose User.isTestUser is
// true — see settleTrade() — and only ever writable in
// development/test (OptionsAdminController). NORMAL/FORCE_WIN/FORCE_LOSS only
// (no DRAW), matching sandboxOutcomeMode's shape.
enum TestUserOutcomeMode {
  NORMAL
  FORCE_WIN
  FORCE_LOSS
}

model OptionTrade {
  id        String          @id @default(uuid())
  userId    String
  accountId String
  symbol    String
  direction OptionDirection

  investment Decimal @db.Decimal(20, 8)
  currency   String

  durationSeconds       Int
  payoutPercentSnapshot Decimal @db.Decimal(6, 3) // snapshotted at creation — never recomputed from current config (Part 5)

  entryPrice          Decimal  @db.Decimal(20, 8)
  entryPriceTimestamp DateTime
  entrySource         String // provider name, e.g. "Binance", "GoldAPI", "Simulated"

  expiryAt             DateTime
  expiryPrice          Decimal?  @db.Decimal(20, 8)
  expiryPriceTimestamp DateTime?
  expirySource         String?

  result       OptionResult?
  profitAmount Decimal?          @db.Decimal(20, 8)
  returnAmount Decimal?          @db.Decimal(20, 8)
  status       OptionTradeStatus @default(ACTIVE)

  requestedResultMode OptionResultMode @default(NORMAL) // Part 26 — see enum doc
  rejectionReason     String? // populated only when status = UNRESOLVED

  createdAt DateTime  @default(now())
  settledAt DateTime?

  user    User    @relation(fields: [userId], references: [id])
  account Account @relation(fields: [accountId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([status, expiryAt])
  @@index([symbol])
}

enum SandboxOutcomeMode {
  RANDOM // default/off — real market-derived outcome, exactly like today
  FORCE_WIN
  FORCE_LOSS
}

// Singleton row (id is always "singleton"), same pattern as PlatformSettings
// — kept as its own table rather than added to PlatformSettings so the
// options product's config can evolve independently of spot/deposits/
// withdrawals/registrations (Part: "separate, clean domain/module").
// `tradingEnabled` defaults FALSE — a brand-new financial product must never
// silently go live the moment its migration runs; an admin must explicitly
// turn it on (see OptionsSettingsService for the enforcement point, mirrored
// after RiskEngineService's GLOBAL_TRADING_DISABLED check for spot).
model OptionsSettings {
  id                     String            @id @default("singleton")
  tradingEnabled         Boolean           @default(false)
  maxActiveTradesPerUser Int?
  maxExposurePerUser     Decimal?          @db.Decimal(20, 8)
  // Trade Experience checkpoint, Part 8 — a PLATFORM-WIDE admin dial,
  // distinct from OptionTrade.requestedResultMode (a per-trade, customer-
  // requested override used by automated tests). Only ever honored when a
  // given trade did NOT request its own override (see options.service.ts's
  // settleTrade()) and only ever writable to a non-RANDOM value in
  // development/test — enforced in OptionsAdminController, the exact same
  // NODE_ENV allow-list as requestedResultMode. Always exists in the schema
  // (so GET reads never 404), but is functionally inert everywhere outside
  // development/test: the write path rejects setting it to anything but
  // RANDOM there, and settlement independently re-checks NODE_ENV before
  // ever honoring a non-RANDOM value.
  sandboxOutcomeMode     SandboxOutcomeMode @default(RANDOM)
  updatedAt              DateTime          @updatedAt
  updatedByAdminId       String?
}
